{
  "name": "mqtt-meshtastic-messenger",
  "version": "0.0.2",
  "description": "MQTT Messenger Application",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "build:all": "electron-builder --win --x64 --linux --x64",
    "pack": "electron-builder --dir"
  },
  "keywords": ["mqtt", "messenger", "electron"],
  "author": {
    "name": "banka",
    "email": "bankastudio@gmail.com"
  },
  "license": "ISC",
  "dependencies": {
    "mqtt": "^5.15.1"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.banka.mqtt-meshtastic-messenger",
    "productName": "MQTT Messenger",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
